# API Laravel en lecture seule (préfixe /api/gpt). Jamais /api/ai.
LOGISTIGA_API_BASE_URL=https://facturation.logistiga.pro/backend/public/api/gpt
# Token Laravel (CHATGPT_API_TOKENS côté Laravel). NE JAMAIS COMMITTER.
LOGISTIGA_API_TOKEN=
LOGISTIGA_API_TIMEOUT_MS=15000

# Clés d'accès ChatGPT -> MCP (séparées par des virgules, 16 caractères minimum). openssl rand -hex 32
MCP_ACCESS_TOKENS=
MCP_RATE_LIMIT=50
MCP_PORT=3333
MCP_BASE_PATH=/mcp-logistiga
MCP_PUBLIC_URL=https://facturation.logistiga.pro/mcp-logistiga
LOG_LEVEL=info
NODE_ENV=production
